<div class="container">
    <h1><%= @task.title%></h1>
    <%= link_to "Edit this task", edit_task_path(@task) %>
    <p><%= @task.details %></p>

    <% if @task.completed %>
    <p><i class="fa-solid fa-square-check text-success"></i> This task is completed</p>
    <% else %>
    <p><i class="fa-regular fa-square"></i> This task is not completed yet</p>
    <% end %>


    <%= link_to "Back to list", tasks_path(@tasks) %>

    <%= link_to "Delete",
      task_path(@task),
      data: {turbo_method: :delete, turbo_confirm: "Are you sure?"}
      %>
</div>